<?xml version="1.0" encoding="utf-8" ?>
<otobo_config version="2.0" init="Application">
    <Setting Name="GenericInterface::Invoker::Module###GitHub::IssuePoll" Required="0" Valid="1">
        <Description Translatable="1">GenericInterface module registration for the GitHub invoker IssuePoll. Creates and updates tickets from the GitHub issues returned by the inbound mapping.</Description>
        <Navigation>GenericInterface::Invoker::ModuleRegistration</Navigation>
        <Value>
            <Hash>
                <Item Key="Name">IssuePoll</Item>
                <Item Key="Controller">GitHub</Item>
                <Item Key="ConfigDialog">AdminGenericInterfaceInvokerDefault</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="GenericInterface::Invoker::Module###GitHub::CommentsGet" Required="0" Valid="1">
        <Description Translatable="1">GenericInterface module registration for the GitHub invoker CommentsGet. Imports the comments of a GitHub issue as articles of a ticket.</Description>
        <Navigation>GenericInterface::Invoker::ModuleRegistration</Navigation>
        <Value>
            <Hash>
                <Item Key="Name">CommentsGet</Item>
                <Item Key="Controller">GitHub</Item>
                <Item Key="ConfigDialog">AdminGenericInterfaceInvokerDefault</Item>
            </Hash>
        </Value>
    </Setting>
    <Setting Name="Daemon::SchedulerCronTaskManager::Task###GitHubIssuePoll" Required="0" Valid="0" ConfigLevel="100">
        <Description Translatable="1">Polls GitHub issues every 5 minutes. Params are the name of the web service and the name of the invoker of type GitHub::IssuePoll.</Description>
        <Navigation>Daemon::SchedulerCronTaskManager::Task</Navigation>
        <Value>
            <Hash>
                <Item Key="TaskName">GitHubIssuePoll</Item>
                <Item Key="Schedule">*/5 * * * *</Item>
                <Item Key="Module">Kernel::System::Console::Command::Maint::GenericInterface::TriggerInvoker</Item>
                <Item Key="Function">Execute</Item>
                <Item Key="MaximumParallelInstances">1</Item>
                <Item Key="Params">
                    <Array>
                        <Item>GitHub</Item>
                        <Item>IssuePoll</Item>
                    </Array>
                </Item>
            </Hash>
        </Value>
    </Setting>
</otobo_config>
